#!/usr/bin/env bash
# pi launcher (Kubeflow 노트북의 code-server·VS Code 웹 터미널 등 Linux 터미널)
SELF="$(readlink -f "${BASH_SOURCE[0]}")"
PI_HOME="$(cd "$(dirname "$SELF")/.." && pwd)"
. "$PI_HOME/bin/find-node.sh"
. "$PI_HOME/bin/kit-config.sh"
NODE="$(pi_find_node)" || {
  echo "[pi] 사용할 수 있는 Node.js(20.15 이상)를 찾지 못했습니다. (진단: bash $PI_HOME/check-node.sh)" >&2
  echo "     node 실행 파일 경로를 ~/.bashrc 에 한 번 적으면 새 터미널부터 씁니다:" >&2
  echo "       echo >> ~/.bashrc; echo 'export PI_NODE=\"/경로/bin/node\"' >> ~/.bashrc" >&2
  exit 1
}
[ -n "$PI_DEBUG" ] && echo "[pi] node: $NODE ($("$NODE" -v))" >&2
export PI_OFFLINE=1 PI_SKIP_VERSION_CHECK=1
# pi 확장(kit.ts: /kit, /doctor)이 버전 번호·문서·진단 도구를 찾을 pi 폴더
export PI_KIT_HOME="$PI_HOME"
CLI="$PI_HOME/runtime/dist/bundle/cli.js"
URL_BASE="file://$PI_HOME"
# code-server·VS Code 터미널에서는 fullscreen 화면으로 (kit-config.sh 의 pi_tui_args: 직접 --tui-mode 를 줬거나 settings.json 에 tuiMode 가 있으면 그대로)
if [ -t 0 ] && [ -t 1 ]; then _tui="$(pi_tui_args "$@")"; [ -n "$_tui" ] && set -- "$@" $_tui; fi
ARGS=()
# Node 22.19 미만(code-server 4.93 에 든 20.15 등)이면 호환 레이어를 먼저 로드
if ! pi_node_ok "$NODE"; then
  ARGS+=(--import "$URL_BASE/compat/node20.mjs")
  # cli.js 는 require(esm) 을 써서 Node 20.15~20.18 에서 실패 -> 실제 진입점 cli-runtime.js 를 직접 실행
  CLI="${CLI%cli.js}cli-runtime.js"
fi
# 한 번 묻기(-p/--print): 터미널(키보드)을 입력으로 기다리지 않게 한다 (파이프로 넘긴 입력은 그대로 전달)
for a in "$@"; do case "$a" in -p|--print) [ -t 0 ] && exec </dev/null; break ;; esac; done
exec "$NODE" "${ARGS[@]}" "$CLI" "$@"
