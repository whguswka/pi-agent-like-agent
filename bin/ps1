#!/usr/bin/env bash
# Windows PowerShell 을 Git Bash 에서 깨짐 없이 실행 (pi 가 bash 도구로 씀. 사람이 써도 됨)
#   ps1 <<'EOF'                여러 줄 스크립트. EOF 를 작은따옴표로 감싸야 bash 가 $변수·\ 를 바꾸지 않음
#   $c = Get-Content a.cs -Raw
#   EOF
#   ps1 -c '한 줄 명령'        작은따옴표로 감쌈
#   ps1 build.ps1 [인자...]    .ps1 파일 실행 (-Config Release 같은 인자도 그대로)
# 하는 일 (2026-10 리소스 모니터 시험에서 PowerShell 실패의 대부분이 이 셋이었음):
#  - bash 의 "..." 안에서 $변수·\ 가 바뀌어 PowerShell 구문 오류가 나지 않게, 스크립트를 임시 .ps1 파일로 써서 -File 로 실행
#  - 실행 정책(스크립트 실행 막힘)은 이 실행에서만 넘김 (-ExecutionPolicy Bypass. 시스템 설정은 바꾸지 않음)
#  - 출력은 UTF-8 로 (한글 오류 문구가 CP949 로 와서 깨지지 않게), 진행 막대는 끔
#  - Windows PowerShell 5.1 은 BOM 없는 .ps1 을 CP949 로 읽어 한글이 깨지므로 heredoc·-c 로 받은 스크립트는 BOM 을 붙여 씀.
#    실행할 .ps1 파일이 BOM 없이 한글을 담고 있으면 그 파일 맨 앞에 BOM 을 붙이고 알림
#  - 종료 코드 (powershell -File 은 마지막 명령이 실패해도 0 으로 끝나므로): 스크립트의 exit 값, throw 로 멈추면 1.
#    heredoc·-c 는 bash 처럼 마지막 명령이 실패하면 1 (외부 프로그램이면 그 종료 코드),
#    .ps1 파일은 마지막으로 실행한 외부 프로그램의 종료 코드 (예: 빌드 도구가 실패하면 그 값)
set -u
usage() {
  sed -n '2,7p' "$0" | sed 's/^# \{0,1\}//' >&2
  exit 2
}
PS="$(command -v powershell.exe 2>/dev/null)"
[ -z "$PS" ] && [ -x /c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe ] && PS=/c/Windows/System32/WindowsPowerShell/v1.0/powershell.exe
[ -z "$PS" ] && { echo "ps1: powershell.exe 를 찾지 못했습니다 (Windows 에서만 씀)" >&2; exit 127; }

# 실행용 파일(run.ps1): UTF-8 출력, 진행 막대 끔 -> 스크립트 실행 -> 그 종료 코드로 끝냄.
# 스크립트는 따로 둔 파일로 실행하므로 오류의 줄 번호가 맞고, 맨 앞에 와야 하는 using·param 도 됨.
# heredoc·-c 로 받은 스크립트 끝에는 마지막 명령의 성공 여부로 끝내는 줄(END)을 붙임
d="$(mktemp -d "${TMPDIR:-/tmp}/pi-ps1-XXXXXX")" || exit 1
trap 'rm -rf "$d"' EXIT
{ printf '\xef\xbb\xbf'
  printf '%s\n' '$ProgressPreference = "SilentlyContinue"' \
    'try { [Console]::OutputEncoding = New-Object System.Text.UTF8Encoding $false } catch {}' \
    '$OutputEncoding = New-Object System.Text.UTF8Encoding $false' \
    '$__f = $args[0]; $__a = @($args | Select-Object -Skip 1)' \
    '$global:LASTEXITCODE = 0' \
    '& $__f @__a' \
    'exit $LASTEXITCODE'; } > "$d/run.ps1"
END='if (-not $?) { if ($LASTEXITCODE) { exit $LASTEXITCODE } else { exit 1 } } else { exit 0 }'

case "${1-}" in
  -h|--help) usage ;;
  -c)
    [ $# -ge 2 ] || usage
    { printf '\xef\xbb\xbf'; printf '%s\n' "$2" "$END"; } > "$d/script.ps1"
    shift 2
    set -- "$(cygpath -aw "$d/script.ps1")" "$@" ;;
  "")
    [ -t 0 ] && usage  # 터미널에서 인자 없이: 사용법 (입력을 기다리지 않게)
    { printf '\xef\xbb\xbf'; cat; printf '\n%s\n' "$END"; } > "$d/script.ps1"
    set -- "$(cygpath -aw "$d/script.ps1")" ;;
  *.ps1|*.PS1)
    f="$1"; shift
    [ -f "$f" ] || { echo "ps1: 파일이 없습니다: $f" >&2; exit 2; }
    # BOM 없이 ASCII 밖의 글자(한글 등)가 있으면 PowerShell 5.1 이 깨뜨려 읽음: 파일 맨 앞에 BOM 을 붙인다
    if [ "$(head -c 3 "$f" | od -An -tx1 | tr -d ' \n')" != "efbbbf" ] && LC_ALL=C grep -q '[^ -~[:space:]]' "$f"; then
      if [ -w "$f" ] && { printf '\xef\xbb\xbf'; cat "$f"; } > "$d/bom" && cat "$d/bom" > "$f"; then
        echo "ps1: $f 에 한글 등이 있어 맨 앞에 UTF-8 BOM 을 붙였습니다 (Windows PowerShell 5.1 이 깨지지 않게 읽도록)" >&2
      else
        echo "ps1: $f 은 BOM 없는 UTF-8 이라 한글이 깨질 수 있습니다 (BOM 을 붙이지 못함)" >&2
      fi
    fi
    set -- "$(cygpath -aw "$f")" "$@" ;;
  *) echo "ps1: 알 수 없는 인자: $1" >&2; usage ;;
esac
"$PS" -NoProfile -NonInteractive -ExecutionPolicy Bypass -File "$(cygpath -aw "$d/run.ps1")" "$@"
